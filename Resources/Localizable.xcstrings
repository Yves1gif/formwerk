    "Formwerk is made for big screens. Open your iPhone Duo to design with the full editor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صُمّم Formwerk للشاشات الكبيرة. افتح جهاز iPhone Duo لتصمّم باستخدام المحرّر الكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk ist für grosse Bildschirme gemacht. Öffne dein iPhone Duo, um mit dem ganzen Editor zu konstruieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk está hecho para pantallas grandes. Abre tu iPhone Duo para diseñar con el editor completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk est conçu pour les grands écrans. Ouvrez votre iPhone Duo pour concevoir avec l’éditeur complet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk बड़ी स्क्रीन के लिए बना है। पूरे एडिटर से डिज़ाइन करने के लिए अपना iPhone Duo खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk dibuat untuk layar besar. Buka iPhone Duo kamu untuk mendesain dengan editor lengkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk è fatto per schermi grandi. Apri il tuo iPhone Duo per progettare con l’editor completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerkは大きな画面向けに作られています。iPhone Duoを開くと、すべての機能を使って設計できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk는 큰 화면을 위해 만들어졌습니다. iPhone Duo를 펼쳐 전체 편집기로 디자인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk is gemaakt voor grote schermen. Open je iPhone Duo om te ontwerpen met de volledige editor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk jest stworzony dla dużych ekranów. Rozłóż iPhone’a Duo, aby projektować w pełnym edytorze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Formwerk foi feito para telas grandes. Abra seu iPhone Duo para projetar com o editor completo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk büyük ekranlar için yapıldı. Tam düzenleyiciyle tasarlamak için iPhone Duo’nu aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk 专为大屏幕设计。展开你的 iPhone Duo，即可使用完整编辑器进行设计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk 專為大螢幕設計。展開你的 iPhone Duo，即可使用完整編輯器進行設計。"
          }
        }
      }
