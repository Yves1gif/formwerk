          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al het andere blijft gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała reszta pozostaje za darmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o resto continua grátis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri kalan her şey ücretsiz kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他一切仍然免费。"
          }
        },
