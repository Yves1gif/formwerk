    "Everything stays editable: tap any step in the timeline to change it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يبقى قابلًا للتعديل: اضغط على أي خطوة في الخط الزمني لتغييرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt bearbeitbar: Tippe in der Zeitleiste auf einen beliebigen Schritt, um ihn zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo sigue siendo editable: toca cualquier paso de la línea de tiempo para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste modifiable : touchez une étape de la chronologie pour la modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ संपादन योग्य रहता है: बदलने के लिए टाइमलाइन में किसी भी चरण पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya tetap bisa diedit: ketuk langkah mana pun di lini masa untuk mengubahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta modificabile: tocca un passaggio qualsiasi nella timeline per cambiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて後から編集できます。タイムラインのステップをタップすると変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것을 계속 편집할 수 있습니다. 타임라인의 단계를 탭하면 변경할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft bewerkbaar: tik op een stap in de tijdlijn om die te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko pozostaje edytowalne: dotknij dowolnego kroku na osi czasu, aby go zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo continua editável: toque em qualquer etapa da linha do tempo para alterá-la."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey düzenlenebilir kalır: değiştirmek için zaman çizelgesindeki herhangi bir adıma dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都可随时修改：轻点时间线中的任意步骤即可更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有內容都能隨時修改：輕點時間軸中的任一步驟即可變更。"
          }
        }
      }
    },
