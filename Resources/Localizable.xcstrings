          "stringUnit": {
            "state": "translated",
            "value": "और छेद जोड़ने के लिए सतह पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk permukaan untuk menambah lubang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la faccia per aggiungere altri fori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面をタップして、穴を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면을 탭하여 구멍을 더 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het zijvlak om meer gaten toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ścianę, aby dodać więcej otworów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na face para adicionar mais furos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazla delik eklemek için yüze dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在面上轻点以添加更多孔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在面上輕點即可加入更多孔。"
          }
        }
      }
    },
    "Tap one edge of the block, then tap Fillet and Done.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على حافة واحدة من المكعب، ثم اضغط على «تقوير» وبعدها «تم»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Kante des Blocks und dann auf Abrunden und Fertig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una arista del bloque y luego toca Redondeo y Listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une arête du bloc, puis touchez Congé et OK."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक के एक किनारे पर टैप करें, फिर फ़िलेट और हो गया पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk satu tepi balok, lalu ketuk Fillet dan Selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca uno spigolo del blocco, poi tocca Raccordo e Fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックのエッジを1本タップし、「フィレット」、「完了」の順にタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블록의 모서리 하나를 탭한 다음 필렛과 완료를 차례로 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een rand van het blok en tik dan op Afronding en Klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij jednej krawędzi bloku, a potem Zaokrąglenie i Gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma aresta do bloco e depois em Arredondamento e OK."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloğun bir kenarına dokunun, sonra Radyus ve Bitti'ye dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点方块的一条边，然后依次轻点“圆角”和“完成”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點方塊的一條邊，然後依序輕點「圓角」和「完成」。"
          }
        }
      }
    },
    "Tap one or more edges first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على حافة واحدة أو أكثر أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zuerst auf eine oder mehrere Kanten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero toca una o más aristas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez d’abord une ou plusieurs arêtes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एक या अधिक किनारों पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk satu tepi atau lebih dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca prima uno o più spigoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず1つ以上のエッジをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 모서리를 하나 이상 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik eerst op een of meer randen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw stuknij jedną lub więcej krawędzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque primeiro em uma ou mais arestas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir ya da daha fazla kenara dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先轻点一条或多条边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先輕點一條或多條邊。"
          }
        }
      }
    },
    "Tap the body to hollow out (or a face to leave open).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الجسم لتفريغه (أو على وجه لتركه مفتوحًا)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Körper, der ausgehöhlt werden soll (oder auf eine Fläche, die offen bleibt)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el cuerpo que quieres vaciar (o una cara para dejarla abierta)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le corps à évider (ou une face à laisser ouverte)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोखला करने के लिए बॉडी पर टैप करें (या खुली छोड़ने के लिए किसी सतह पर)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk bodi yang akan dibuat berongga (atau permukaan yang dibiarkan terbuka)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il corpo da svuotare (o una faccia da lasciare aperta)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボディをタップして中空にします(開いたままにする面をタップすることもできます)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속을 비울 바디를 탭하세요 (또는 열어 둘 면을 탭)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het lichaam om uit te hollen (of op een zijvlak om open te laten)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij bryłę do wydrążenia (lub ścianę, która ma zostać otwarta)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no corpo para esvaziá-lo (ou em uma face para deixá-la aberta)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçi boşaltılacak gövdeye (ya da açık kalacak yüze) dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点要抽壳的实体（或要保持开放的面）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點要抽殼的實體（或要保持開放的面）。"
          }
        }
      }
    },
    "Tap the centre, the start, then the end (counter-clockwise).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على المركز، ثم البداية، ثم النهاية (عكس اتجاه عقارب الساعة)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Mittelpunkt, den Anfang und dann das Ende (gegen den Uhrzeigersinn)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el centro, el inicio y luego el final (en sentido antihorario)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le centre, le début, puis la fin (sens antihoraire)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केंद्र, फिर शुरुआत, फिर अंत पर टैप करें (वामावर्त)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk pusat, awal, lalu akhir (berlawanan arah jarum jam)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il centro, l’inizio e poi la fine (in senso antiorario)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中心、始点、終点の順にタップしてください(反時計回り)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중심, 시작점, 끝점 순서로 탭하세요 (반시계 방향)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het middelpunt, het begin en dan het einde (tegen de klok in)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij środek, początek, a potem koniec (przeciwnie do ruchu wskazówek zegara)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no centro, no início e depois no fim (sentido anti-horário)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkeze, başlangıca, sonra bitişe dokunun (saat yönünün tersine)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依次轻点圆心、起点和终点（逆时针）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依序輕點圓心、起點和終點（逆時針）。"
          }
        }
      }
    },
    "Tap the centre, then a corner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على المركز، ثم على زاوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Mittelpunkt, dann auf eine Ecke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el centro y luego una esquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le centre, puis un coin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केंद्र पर टैप करें, फिर किसी कोने पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk pusat, lalu satu sudut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il centro, poi un angolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中心、続けて角をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중심을 탭한 다음 모서리를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het middelpunt en dan op een hoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij środek, a potem narożnik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no centro e depois em um canto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkeze, sonra bir köşeye dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点中心，然后轻点一个角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點中心，然後輕點一個角。"
          }
        }
      }
    },
    "Tap the centre, then a point on the circle.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على المركز، ثم على نقطة على الدائرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Mittelpunkt, dann auf einen Punkt auf dem Kreis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el centro y luego un punto del círculo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le centre, puis un point du cercle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केंद्र पर टैप करें, फिर वृत्त के किसी बिंदु पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk pusat, lalu satu titik pada lingkaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il centro, poi un punto sul cerchio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中心、続けて円周上の点をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중심을 탭한 다음 원 위의 점을 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het middelpunt en dan op een punt op de cirkel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij środek, a potem punkt na okręgu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no centro e depois em um ponto do círculo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkeze, sonra daire üzerinde bir noktaya dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点圆心，然后轻点圆上一点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點圓心，然後輕點圓上一點。"
          }
        }
      }
    },
    "Tap the flat face where the hole goes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الوجه المسطح الذي سيوضع فيه الثقب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die ebene Fläche, auf die die Bohrung kommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la cara plana donde irá el agujero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la face plane où placer le trou."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस समतल सतह पर छेद करना है उस पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk permukaan datar tempat lubang dibuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la faccia piana dove va il foro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穴を開ける平らな面をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구멍을 만들 평평한 면을 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het vlakke zijvlak waar het gat moet komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij płaską ścianę, na której ma być otwór."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na face plana onde o furo vai ficar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deliğin açılacağı düz yüze dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点要放置孔的平面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點要放置孔的平面。"
          }
        }
      }
    },
    "Tap the start, then each next point. Tap the first point to close.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على البداية، ثم على كل نقطة تالية. اضغط على النقطة الأولى للإغلاق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Anfang, dann auf jeden weiteren Punkt. Tippe auf den ersten Punkt, um zu schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el inicio y luego cada punto siguiente. Toca el primer punto para cerrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le début, puis chaque point suivant. Touchez le premier point pour fermer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआत पर टैप करें, फिर हर अगले बिंदु पर। बंद करने के लिए पहले बिंदु पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk titik awal, lalu setiap titik berikutnya. Ketuk titik pertama untuk menutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca l’inizio, poi ogni punto successivo. Tocca il primo punto per chiudere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始点、続けて次の点を順にタップします。最初の点をタップすると閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작점을 탭한 다음 각 점을 차례로 탭하세요. 첫 점을 탭하면 닫힙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het beginpunt en dan op elk volgend punt. Tik op het eerste punt om te sluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij początek, a potem każdy kolejny punkt. Stuknij pierwszy punkt, aby zamknąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no início e depois em cada ponto seguinte. Toque no primeiro ponto para fechar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıca, sonra her bir sonraki noktaya dokunun. Kapatmak için ilk noktaya dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点起点，再依次轻点后续各点。轻点第一个点以闭合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點起點，再依序輕點後續各點。輕點第一個點即可閉合。"
          }
        }
      }
    },
    "Tap the two centres, then the width.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على المركزين، ثم على العرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die beiden Mittelpunkte, dann auf die Breite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca los dos centros y luego el ancho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez les deux centres, puis la largeur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो केंद्रों पर टैप करें, फिर चौड़ाई तय करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kedua pusat, lalu lebarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca i due centri, poi la larghezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの中心、続けて幅をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 중심을 탭한 다음 너비를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de twee middelpunten en dan op de breedte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwa środki, a potem szerokość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nos dois centros e depois na largura."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki merkeze, sonra genişliğe dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两个圆心，然后确定宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點兩個圓心，然後決定寬度。"
          }
        }
      }
    },
    "Tap to place a point.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لوضع نقطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um einen Punkt zu setzen."
