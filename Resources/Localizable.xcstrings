    "On iPad and iPhone: place your part on the desk at real size.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على iPad وiPhone: ضع قطعتك على المكتب بحجمها الحقيقي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf iPad und iPhone: Stell dein Teil in Originalgrösse auf den Tisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPad y iPhone: coloca tu pieza sobre la mesa a tamaño real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPad et iPhone : posez votre pièce sur le bureau en taille réelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad और iPhone पर: अपने पार्ट को असली आकार में मेज़ पर रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iPad dan iPhone: letakkan komponenmu di meja dalam ukuran asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPad e iPhone: metti la tua parte sulla scrivania a grandezza reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadとiPhoneで：パーツを実寸で机の上に置いて確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad와 iPhone에서: 부품을 실제 크기로 책상 위에 놓아 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op iPad en iPhone: zet je onderdeel op ware grootte op je bureau."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iPadzie i iPhonie: postaw część na biurku w rzeczywistym rozmiarze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPad e iPhone: coloque sua peça na mesa em tamanho real."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad ve iPhone'da: parçanı gerçek boyutta masana yerleştir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 和 iPhone 上：把零件按真实尺寸放到桌面上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 和 iPhone 上：把零件按真實尺寸放到桌面上。"
          }
        }
      }
    },
