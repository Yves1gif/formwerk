        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면을 탭하여 구멍을 더 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het zijvlak om meer gaten toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ścianę, aby dodać więcej otworów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na face para adicionar mais furos."
          }
        },
        "tr": {
