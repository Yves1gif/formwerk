            "state": "translated",
            "value": "Belum ada yang bisa dipindahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è ancora niente da spostare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動するものはまだありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 이동할 항목이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog niets om te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze czego przesunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada para mover."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz taşınacak bir şey yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可移动的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無可移動的內容。"
          }
        }
      }
    },
    "These constraints contradict each other. Remove one of the red ones.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه القيود تتعارض مع بعضها. احذف أحد القيود الحمراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bedingungen widersprechen sich. Entferne eine der roten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas restricciones se contradicen. Elimina una de las rojas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces contraintes se contredisent. Supprimez l’une des contraintes rouges."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये बंधन एक-दूसरे का विरोध करते हैं। लाल वालों में से एक हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batasan ini saling bertentangan. Hapus salah satu yang merah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi vincoli sono in conflitto. Rimuovi uno di quelli rossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの拘束は互いに矛盾しています。赤いものを1つ削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구속 조건들이 서로 충돌합니다. 빨간색 중 하나를 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze beperkingen spreken elkaar tegen. Verwijder een van de rode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te wiązania są ze sobą sprzeczne. Usuń jedno z czerwonych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas restrições se contradizem. Remova uma das vermelhas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısıtlamalar birbiriyle çelişiyor. Kırmızı olanlardan birini kaldırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些约束相互冲突。请移除一个红色约束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些約束相互衝突。請移除其中一個紅色約束。"
          }
        }
      }
    },
    "This body has gaps or open faces. Slicers may fill it wrongly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا الجسم على فجوات أو أوجه مفتوحة. قد تملؤه برامج التقطيع بشكل خاطئ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Körper hat Lücken oder offene Flächen. Slicer füllen ihn eventuell falsch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cuerpo tiene huecos o caras abiertas. Los laminadores podrían rellenarlo mal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce corps présente des trous ou des faces ouvertes. Les slicers risquent de mal le remplir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बॉडी में दरारें या खुली सतहें हैं। Slicer इसे गलत तरीके से भर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodi ini punya celah atau permukaan terbuka. Slicer bisa salah mengisinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo corpo ha buchi o facce aperte. Gli slicer potrebbero riempirlo in modo errato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボディには隙間や開いた面があります。スライサーで正しく処理されない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 바디에 틈이나 열린 면이 있습니다. 슬라이서가 잘못 채울 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit lichaam heeft gaten of open zijvlakken. Slicers kunnen het verkeerd opvullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bryła ma szczeliny lub otwarte ściany. Slicery mogą ją źle wypełnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este corpo tem lacunas ou faces abertas. Os fatiadores podem preenchê-lo de forma incorreta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gövdede boşluklar ya da açık yüzler var. Dilimleyiciler onu yanlış doldurabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此实体有缝隙或开放面，切片软件可能会错误填充。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此實體有縫隙或開放面，切片軟體可能會錯誤填充。"
          }
        }
      }
    },
    "This device can't show 3D graphics (Metal is missing).": {
