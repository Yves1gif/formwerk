        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在面上輕點即可加入更多孔。"
          }
        }
      }
    },
    "Tap one edge of the block, then tap Fillet and Done.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على حافة واحدة من المكعب، ثم اضغط على «تقوير» وبعدها «تم»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Kante des Blocks und dann auf Abrunden und Fertig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una arista del bloque y luego toca Redondeo y Listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une arête du bloc, puis touchez Congé et OK."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक के एक किनारे पर टैप करें, फिर फ़िलेट और हो गया पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk satu tepi balok, lalu ketuk Fillet dan Selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca uno spigolo del blocco, poi tocca Raccordo e Fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックのエッジを1本タップし、「フィレット」、「完了」の順にタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블록의 모서리 하나를 탭한 다음 필렛과 완료를 차례로 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een rand van het blok en tik dan op Afronding en Klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij jednej krawędzi bloku, a potem Zaokrąglenie i Gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma aresta do bloco e depois em Arredondamento e OK."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloğun bir kenarına dokunun, sonra Radyus ve Bitti'ye dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点方块的一条边，然后依次轻点“圆角”和“完成”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點方塊的一條邊，然後依序輕點「圓角」和「完成」。"
          }
        }
      }
    },
    "Tap one or more edges first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على حافة واحدة أو أكثر أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zuerst auf eine oder mehrere Kanten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero toca una o más aristas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez d’abord une ou plusieurs arêtes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एक या अधिक किनारों पर टैप करें।"
