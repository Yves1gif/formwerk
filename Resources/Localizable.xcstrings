    "Tap Print at the top right to check your part and export it for your slicer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على «طباعة» في أعلى اليمين لفحص قطعتك وتصديرها إلى برنامج التقطيع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf Drucken, um dein Teil zu prüfen und für deinen Slicer zu exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Imprimir arriba a la derecha para revisar tu pieza y exportarla a tu slicer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Imprimer en haut à droite pour vérifier votre pièce et l’exporter vers votre slicer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पार्ट जाँचने और अपने स्लाइसर के लिए एक्सपोर्ट करने के लिए ऊपर दाईं ओर प्रिंट पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Cetak di kanan atas untuk memeriksa bagian Anda dan mengekspornya ke slicer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Stampa in alto a destra per controllare il pezzo ed esportarlo per il tuo slicer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「印刷」をタップすると、パーツを確認してスライサー用に書き出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위의 출력을 탭하면 부품을 확인하고 슬라이서용으로 내보낼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik rechtsboven op Print om je onderdeel te controleren en te exporteren voor je slicer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij Druk w prawym górnym rogu, aby sprawdzić część i wyeksportować ją do slicera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Imprimir no canto superior direito para verificar sua peça e exportá-la para o seu slicer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçanızı kontrol edip dilimleyiciniz için dışa aktarmak üzere sağ üstteki Baskı'ya dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点右上角的“打印”，检查零件并导出到切片软件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點右上角的「列印」，檢查零件並匯出給切片軟體。"
          }
        }
      }
    },
    "Tap Sketch to start. You will draw on the ground.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على رسم للبدء. سترسم على الأرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Skizze, um zu beginnen. Du zeichnest auf den Boden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Boceto para empezar. Dibujarás sobre el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Esquisse pour commencer. Vous dessinez sur le sol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए स्केच पर टैप करें। आप ज़मीन पर ड्रॉ करेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Sketsa untuk mulai. Kamu menggambar di bidang dasar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Schizzo per iniziare. Disegnerai sul piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケッチをタップして始めます。地面に描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스케치를 탭하여 시작하세요. 바닥에 그리게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Schets om te beginnen. Je tekent op de grond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Szkic, aby zacząć. Rysujesz na podłożu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Esboço para começar. Você desenha no chão."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için Eskiz'e dokun. Zemine çizeceksin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“草图”开始。你将在地面上绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「草圖」開始。你會在地面上繪製。"
          }
        }
      }
    },
    "Tap a flat face first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على وجه مسطح أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zuerst auf eine ebene Fläche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero toca una cara plana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez d’abord une face plane."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले किसी समतल सतह पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk permukaan datar dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca prima una faccia piana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず平らな面をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 평평한 면을 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik eerst op een vlak zijvlak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw stuknij płaską ścianę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque primeiro em uma face plana."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce düz bir yüze dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先轻点一个平面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先輕點一個平面。"
          }
        }
      }
    },
    "Tap a flat face to mirror across it, or pick a main plane.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على وجه مسطح للانعكاس عبره، أو اختر مستوى رئيسيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine ebene Fläche, um daran zu spiegeln, oder wähle eine Hauptebene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una cara plana para hacer la simetría respecto a ella, o elige un plano principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une face plane pour l’utiliser comme miroir, ou choisissez un plan principal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसके आर-पार दर्पण बनाने के लिए समतल सतह पर टैप करें, या मुख्य समतल चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk permukaan datar untuk mencerminkan terhadapnya, atau pilih bidang utama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una faccia piana per specchiare rispetto a essa, o scegli un piano principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平らな面をタップしてミラーするか、基準平面を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평평한 면을 탭하면 그 면을 기준으로 대칭되고, 기본 평면을 선택할 수도 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een vlak zijvlak om erover te spiegelen, of kies een hoofdvlak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij płaską ścianę, aby odbić względem niej, lub wybierz główną płaszczyznę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma face plana para espelhar a partir dela ou escolha um plano principal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yansıtmak için düz bir yüze dokunun ya da bir ana düzlem seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一个平面作为镜像面，或选择一个基准平面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點一個平面作為鏡射面，或選擇一個基準面。"
          }
        }
      }
    },
    "Tap a flat face to put the text there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على وجه مسطح لوضع النص عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine ebene Fläche, um den Text dort zu platzieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una cara plana para colocar el texto ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une face plane pour y placer le texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट वहाँ रखने के लिए समतल सतह पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk permukaan datar untuk menaruh teks di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una faccia piana per inserirvi il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平らな面をタップして、そこにテキストを配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 놓을 평평한 면을 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een vlak zijvlak om de tekst daar te plaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij płaską ścianę, aby umieścić na niej tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma face plana para colocar o texto nela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni yerleştirmek için düz bir yüze dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一个平面以放置文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點一個平面以放置文字。"
          }
        }
      }
    },
    "Tap a line, circle or two points to add a dimension.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على خط أو دائرة أو نقطتين لإضافة بُعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Linie, einen Kreis oder zwei Punkte, um eine Bemaßung hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una línea, un círculo o dos puntos para añadir una cota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une ligne, un cercle ou deux points pour ajouter une cote."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माप जोड़ने के लिए रेखा, वृत्त या दो बिंदुओं पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk garis, lingkaran, atau dua titik untuk menambah dimensi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una linea, un cerchio o due punti per aggiungere una quota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線、円、または2点をタップして寸法を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선, 원 또는 두 점을 탭하여 치수를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een lijn, cirkel of twee punten om een maat toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij linię, okrąg lub dwa punkty, aby dodać wymiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma linha, um círculo ou dois pontos para adicionar uma cota."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçü eklemek için bir çizgiye, daireye ya da iki noktaya dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点直线、圆或两个点以添加尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點直線、圓或兩個點以加入尺寸。"
          }
        }
      }
    },
    "Tap a side to type its exact length if you like. Then tap Done at the top.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على ضلع لكتابة طوله الدقيق إن أردت. ثم اضغط على «تم» في الأعلى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Seite, um ihre genaue Länge einzugeben. Tippe dann oben auf Fertig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un lado para escribir su longitud exacta si quieres. Luego toca Listo arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un côté pour saisir sa longueur exacte si vous le souhaitez. Puis touchez OK en haut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चाहें तो किसी भुजा पर टैप करके उसकी सटीक लंबाई टाइप करें। फिर ऊपर हो गया पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk sisi untuk mengetik panjang pastinya. Lalu ketuk Selesai di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un lato per digitarne la lunghezza esatta, se vuoi. Poi tocca Fine in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辺をタップすると正確な長さを入力できます。そのあと上の「完了」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변을 탭하면 정확한 길이를 입력할 수 있습니다. 그런 다음 위쪽의 완료를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een zijde om de exacte lengte in te typen. Tik daarna bovenaan op Klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij boku, aby wpisać jego dokładną długość. Potem dotknij Gotowe u góry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um lado para digitar o comprimento exato, se quiser. Depois toque em OK no topo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsterseniz bir kenara dokunup tam uzunluğunu yazın. Sonra üstteki Bitti'ye dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点某条边即可输入精确长度。然后轻点顶部的“完成”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點某條邊即可輸入精確長度。然後輕點頂部的「完成」。"
          }
        }
      }
    },
    "Tap faces to leave them open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الأوجه لتركها مفتوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Flächen, die offen bleiben sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca las caras que quieras dejar abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez les faces à laisser ouvertes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुली छोड़ने के लिए सतहों पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk permukaan yang ingin dibiarkan terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca le facce da lasciare aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面をタップすると、その面は開いたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열어 둘 면을 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op zijvlakken om ze open te laten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ściany, które mają pozostać otwarte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nas faces para deixá-las abertas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık kalacak yüzlere dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点面使其保持开放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
