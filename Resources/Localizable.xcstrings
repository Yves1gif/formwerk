        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार भुगतान करें। iPad, iPhone और Mac पर आपका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayar sekali. Milikmu di iPad, iPhone, dan Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paghi una volta. Tuo su iPad, iPhone e Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、iPad・iPhone・Macのすべてで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 결제로 iPad, iPhone, Mac에서 모두 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer betalen. Van jou op iPad, iPhone en Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płacisz raz. Twoje na iPadzie, iPhonie i Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague uma vez. Seu no iPad, iPhone e Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez öde. iPad, iPhone ve Mac'te senin."
