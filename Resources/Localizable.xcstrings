    "On other iPhones, use Formwerk on your iPad or Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على أجهزة iPhone الأخرى، استخدم Formwerk على iPad أو Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf anderen iPhones nutze Formwerk auf deinem iPad oder Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En otros iPhone, usa Formwerk en tu iPad o Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les autres iPhone, utilisez Formwerk sur votre iPad ou Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे iPhone पर, Formwerk को अपने iPad या Mac पर इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iPhone lain, gunakan Formwerk di iPad atau Mac kamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugli altri iPhone, usa Formwerk su iPad o Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのiPhoneでは、iPadまたはMacでFormwerkをお使いください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 iPhone에서는 iPad나 Mac에서 Formwerk를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Formwerk op andere iPhones op je iPad of Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na innych iPhone’ach używaj Formwerk na iPadzie lub Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em outros iPhones, use o Formwerk no iPad ou Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer iPhone’larda Formwerk’ü iPad’inde veya Mac’inde kullan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他 iPhone 上，请在 iPad 或 Mac 上使用 Formwerk。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他 iPhone 上，請在 iPad 或 Mac 上使用 Formwerk。"
          }
        }
      }
    },
    "One finger turns the view, two fingers move and zoom.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصبع واحد يدوّر العرض، وإصبعان يحرّكان ويكبّران."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Finger dreht die Ansicht, zwei Finger verschieben und zoomen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dedo gira la vista; dos dedos la mueven y hacen zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doigt tourne la vue, deux doigts déplacent et zooment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक उँगली से व्यू घूमता है, दो उँगलियों से खिसकता और ज़ूम होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu jari memutar tampilan, dua jari menggeser dan zoom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dito ruota la vista, due dita spostano e fanno lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1本指でビューを回転、2本指で移動とズームをします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 보기를 회전하고, 두 손가락으로 이동 및 확대/축소합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén vinger draait de weergave, twee vingers verplaatsen en zoomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden palec obraca widok, dwa palce przesuwają i przybliżają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dedo gira a vista; dois dedos movem e dão zoom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek parmak görünümü döndürür, iki parmak kaydırır ve yakınlaştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
