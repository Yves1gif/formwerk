    "Pick Rectangle, then tap two opposite corners on the grid.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر «مستطيل»، ثم اضغط على ركنين متقابلين على الشبكة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Rechteck und tippe dann auf dem Raster auf zwei gegenüberliegende Ecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Rectángulo y toca dos esquinas opuestas de la cuadrícula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Rectangle, puis touchez deux coins opposés sur la grille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयत चुनें, फिर ग्रिड पर दो आमने-सामने के कोनों पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Persegi panjang, lalu ketuk dua sudut yang berseberangan pada grid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Rettangolo, poi tocca due angoli opposti sulla griglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「長方形」を選び、グリッド上で向かい合う2つの角をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직사각형을 선택한 다음 격자에서 마주 보는 두 모서리를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Rechthoek en tik op twee tegenoverliggende hoeken op het raster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz Prostokąt, a potem dotknij dwóch przeciwległych rogów na siatce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Retângulo e toque em dois cantos opostos na grade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikdörtgen'i seçin, sonra ızgarada iki karşıt köşeye dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“矩形”，然后在网格上轻点两个对角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「矩形」，然後在格線上輕點兩個對角。"
          }
        }
      }
    },
