    "Right-click selects what's under the pointer and shows what you can do with it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقر بالزر الأيمن يحدد ما تحت المؤشر ويعرض ما يمكنك فعله به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick wählt aus, was unter dem Zeiger liegt, und zeigt, was du damit machen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El clic derecho selecciona lo que hay bajo el puntero y muestra qué puedes hacer con ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clic droit sélectionne ce qui est sous le pointeur et montre ce que vous pouvez en faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राइट-क्लिक पॉइंटर के नीचे की चीज़ चुनता है और दिखाता है कि आप उससे क्या कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan memilih apa yang ada di bawah penunjuk dan menampilkan yang bisa Anda lakukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il clic destro seleziona ciò che è sotto il puntatore e mostra cosa puoi farne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右クリックでポインタの下にあるものを選択し、できる操作を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 클릭하면 포인터 아래 항목을 선택하고 할 수 있는 작업을 보여줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklikken selecteert wat onder de aanwijzer ligt en toont wat je ermee kunt doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawy klik zaznacza to, co jest pod wskaźnikiem, i pokazuje, co możesz z tym zrobić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O clique direito seleciona o que está sob o ponteiro e mostra o que você pode fazer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ tıklama, imlecin altındakini seçer ve onunla neler yapabileceğinizi gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按会选择指针下的对象，并显示可执行的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右鍵點按會選取指標下的物件，並顯示可執行的操作。"
          }
        }
      }
    },
    "Right-drag orbits, middle-drag pans, the wheel zooms.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السحب بالزر الأيمن يدوّر، وبالزر الأوسط يحرّك، والعجلة تكبّر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts ziehen dreht, mittig ziehen verschiebt, das Mausrad zoomt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastrar con el botón derecho gira, con el central desplaza, la rueda hace zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser avec le bouton droit fait pivoter, avec le bouton central déplace, la molette zoome."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राइट-ड्रैग घुमाता है, मिडल-ड्रैग खिसकाता है, व्हील ज़ूम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret kanan memutar, seret tengah menggeser, roda memperbesar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinare col tasto destro ruota, col tasto centrale sposta, la rotella zooma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右ドラッグで回転、中ドラッグで移動、ホイールでズーム。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 드래그는 회전, 가운데 드래그는 이동, 휠은 확대/축소입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts slepen draait, middelste knop slepen schuift, het wiel zoomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciąganie prawym obraca, środkowym przesuwa, kółko powiększa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastar com o botão direito gira, com o do meio move, a roda dá zoom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ tuşla sürükleme döndürür, orta tuşla kaydırır, tekerlek yakınlaştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键拖移旋转，中键拖移平移，滚轮缩放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右鍵拖移旋轉，中鍵拖移平移，滾輪縮放。"
          }
        }
      }
    },
