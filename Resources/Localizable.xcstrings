    "Two-finger tap: undo. Three-finger tap: redo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضغطة بإصبعين: تراجع. ضغطة بثلاثة أصابع: إعادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit zwei Fingern tippen: Widerrufen. Mit drei Fingern tippen: Wiederholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque con dos dedos: deshacer. Toque con tres dedos: rehacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher à deux doigts : annuler. Toucher à trois doigts : rétablir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो उँगलियों से टैप: पूर्ववत। तीन उँगलियों से टैप: फिर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua jari: urungkan. Ketuk tiga jari: ulangi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocco con due dita: annulla. Tocco con tre dita: ripristina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2本指タップで取り消し、3本指タップでやり直しです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락 탭: 실행 취소. 세 손가락 탭: 다시 실행."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik met twee vingers: ongedaan maken. Tik met drie vingers: opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknięcie dwoma palcami: cofnij. Stuknięcie trzema palcami: ponów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque com dois dedos: desfazer. Toque com três dedos: refazer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki parmakla dokunma: geri al. Üç parmakla dokunma: yinele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双指轻点：撤销。三指轻点：重做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙指輕點：還原。三指輕點：重做。"
          }
        }
      }
    },
    "Type the size. You can change it any time in the timeline.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب المقاس. يمكنك تغييره في أي وقت من الخط الزمني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Größe ein. Du kannst sie jederzeit in der Zeitleiste ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el tamaño. Puedes cambiarlo en cualquier momento en la línea de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la taille. Vous pouvez la modifier à tout moment dans l’historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माप टाइप करें। आप इसे कभी भी टाइमलाइन में बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik ukurannya. Anda bisa mengubahnya kapan saja di linimasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la dimensione. Puoi cambiarla in qualsiasi momento nella cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズを入力してください。タイムラインでいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기를 입력하세요. 타임라인에서 언제든지 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ de maat. Je kunt die altijd wijzigen in de tijdlijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz rozmiar. Możesz go zmienić w każdej chwili na osi czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o tamanho. Você pode alterá-lo a qualquer momento na linha do tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutu yazın. Zaman çizelgesinde istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入尺寸。之后可随时在时间线中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入尺寸。之後可隨時在時間軸中更改。"
          }
        }
      }
    },
