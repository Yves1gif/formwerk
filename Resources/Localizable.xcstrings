    "The model changed a lot here. Check that this step still uses the right face or edge.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر النموذج كثيرًا هنا. تحقق من أن هذه الخطوة ما زالت تستخدم الوجه أو الحافة الصحيحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat sich hier stark verändert. Prüfe, ob dieser Schritt noch die richtige Fläche oder Kante nutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo cambió mucho aquí. Comprueba que este paso siga usando la cara o arista correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle a beaucoup changé ici. Vérifiez que cette étape utilise toujours la bonne face ou arête."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल यहाँ काफ़ी बदल गया है। जाँचें कि यह चरण अब भी सही सतह या किनारे का उपयोग कर रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model banyak berubah di sini. Periksa apakah langkah ini masih memakai permukaan atau tepi yang benar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è cambiato molto qui. Verifica che questo passo usi ancora la faccia o lo spigolo giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでモデルが大きく変わりました。このステップが正しい面またはエッジを使用しているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 모델이 크게 바뀌었습니다. 이 단계가 올바른 면이나 모서리를 사용하는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model is hier sterk veranderd. Controleer of deze stap nog het juiste zijvlak of de juiste rand gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model w tym miejscu bardzo się zmienił. Sprawdź, czy ten krok nadal używa właściwej ściany lub krawędzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo mudou bastante aqui. Verifique se esta etapa ainda usa a face ou a aresta certa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model burada çok değişti. Bu adımın hâlâ doğru yüzü ya da kenarı kullandığını kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型在此处变化较大。请检查此步骤是否仍使用正确的面或边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型在此處變動很大。請檢查此步驟是否仍使用正確的面或邊。"
          }
        }
      }
    },
