    "%@ cm² hang over more than %lld°. They need supports or a different orientation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبرز %@ سم² بأكثر من %lld°. تحتاج إلى دعامات أو اتجاه مختلف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² hängen mehr als %lld° über. Sie brauchen Stützen oder eine andere Ausrichtung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² sobresalen más de %lld°. Necesitan soportes u otra orientación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² sont en porte-à-faux de plus de %lld°. Ajoutez des supports ou changez l’orientation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² %lld° से ज़्यादा बाहर निकला हुआ है। इसके लिए सपोर्ट या दूसरी दिशा चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² menggantung lebih dari %lld°. Perlu penyangga atau orientasi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² sporgono più di %lld°. Servono supporti o un orientamento diverso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm²が%lld°を超えて張り出しています。サポートを追加するか、向きを変える必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm²가 %lld° 넘게 돌출되어 있습니다. 서포트가 필요하거나 방향을 바꿔야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² steekt meer dan %lld° uit. Dit heeft support nodig of een andere oriëntatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² zwisa pod kątem większym niż %lld°. Potrzebne są podpory lub inne ułożenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² têm um balanço de mais de %lld°. Eles precisam de suportes ou de outra orientação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² alanın sarkma açısı %lld° üzerinde. Destek ya da farklı bir yön gerekiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² 的悬垂超过 %lld°，需要支撑或调整摆放方向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cm² 的懸空超過 %lld°，需要支撐或調整擺放方向。"
          }
        }
      }
    },
