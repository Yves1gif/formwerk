    "Start with a sketch on the ground, or drop in a basic shape and change it later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ برسم على الأرضية، أو أضف شكلًا أساسيًا وعدّله لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit einer Skizze auf dem Boden oder setze eine Grundform ein und ändere sie später."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con un boceto en el suelo o inserta una forma básica y cámbiala después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par une esquisse au sol, ou ajoutez une forme de base et modifiez-la plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़मीन पर स्केच से शुरू करें, या कोई बुनियादी आकृति डालें और बाद में बदलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan sketsa di bidang dasar, atau masukkan bentuk dasar dan ubah nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con uno schizzo sul piano, oppure inserisci una forma base e modificala dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "底面にスケッチを描くか、基本形状を配置して、後から変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바닥에서 스케치로 시작하거나 기본 도형을 넣고 나중에 수정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met een schets op de grond of plaats een basisvorm en pas die later aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od szkicu na podłożu albo wstaw prosty kształt i zmień go później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um esboço na base ou insira uma forma básica e altere-a depois."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeminde bir eskizle başla ya da temel bir şekil ekleyip sonra değiştir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在地面上画草图，或放入一个基本形状，之后再修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在地面上繪製草圖，或放入基本形狀，之後再修改。"
          }
        }
      }
    },
