    "Once you use Apple Pencil, the Pencil draws and one finger orbits the view.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد استخدام Apple Pencil، يرسم القلم وتدوّر إصبع واحدة العرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du den Apple Pencil benutzt, zeichnet der Pencil und ein Finger dreht die Ansicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuanto usas el Apple Pencil, el Pencil dibuja y un dedo gira la vista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que vous utilisez l’Apple Pencil, le Pencil dessine et un doigt fait pivoter la vue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil इस्तेमाल करते ही Pencil ड्रॉ करता है और एक उंगली व्यू घुमाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah Anda memakai Apple Pencil, Pencil menggambar dan satu jari memutar tampilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando usi Apple Pencil, la Pencil disegna e un dito ruota la vista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencilを使うと、Pencilで描き、1本指でビューを回転します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil을 사용하면 Pencil로 그리고 한 손가락으로 뷰를 회전합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra je Apple Pencil gebruikt, tekent de Pencil en draait één vinger het aanzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy użyjesz Apple Pencil, Pencil rysuje, a jeden palec obraca widok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que você usa o Apple Pencil, o Pencil desenha e um dedo gira a vista."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil’ı kullandığınızda Pencil çizer, tek parmak görünümü döndürür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Pencil 后，用 Pencil 绘图，单指旋转视图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Pencil 後，用 Pencil 繪圖，單指旋轉視圖。"
          }
        }
      }
    },
    "One finger draws, as without a Pencil. Drag on empty space to orbit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصبع واحدة ترسم، كما بدون القلم. اسحب على مساحة فارغة للتدوير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Finger zeichnet, wie ohne Pencil. Zum Drehen auf einer leeren Stelle ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dedo dibuja, como sin Pencil. Arrastra en un espacio vacío para girar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doigt dessine, comme sans Pencil. Faites glisser sur une zone vide pour pivoter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना Pencil की तरह एक उंगली ड्रॉ करती है। घुमाने के लिए खाली जगह पर ड्रैग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu jari menggambar, seperti tanpa Pencil. Seret di area kosong untuk memutar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dito disegna, come senza Pencil. Trascina su uno spazio vuoto per ruotare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencilがないときと同じく1本指で描きます。何もない所をドラッグすると回転します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencil이 없을 때처럼 한 손가락으로 그립니다. 빈 곳을 드래그하면 회전합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén vinger tekent, net als zonder Pencil. Sleep op een lege plek om te draaien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden palec rysuje, jak bez Pencil. Przeciągnij po pustym miejscu, aby obrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dedo desenha, como sem Pencil. Arraste num espaço vazio para girar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencil yokmuş gibi tek parmak çizer. Döndürmek için boş alanda sürükleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与没有 Pencil 时一样，单指绘图。在空白处拖移可旋转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與沒有 Pencil 時一樣，單指繪圖。在空白處拖移可旋轉。"
          }
        }
      }
    },
    "One finger turns the view, two fingers move and zoom.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصبع واحد يدوّر العرض، وإصبعان يحرّكان ويكبّران."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Finger dreht die Ansicht, zwei Finger verschieben und zoomen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dedo gira la vista; dos dedos la mueven y hacen zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doigt tourne la vue, deux doigts déplacent et zooment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक उँगली से व्यू घूमता है, दो उँगलियों से खिसकता और ज़ूम होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu jari memutar tampilan, dua jari menggeser dan zoom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dito ruota la vista, due dita spostano e fanno lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1本指でビューを回転、2本指で移動とズームをします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 보기를 회전하고, 두 손가락으로 이동 및 확대/축소합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén vinger draait de weergave, twee vingers verplaatsen en zoomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden palec obraca widok, dwa palce przesuwają i przybliżają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dedo gira a vista; dois dedos movem e dão zoom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek parmak görünümü döndürür, iki parmak kaydırır ve yakınlaştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指旋转视图，双指平移和缩放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單指旋轉檢視，雙指平移和縮放。"
          }
        }
      }
    },
    "One-time purchase, no subscription.": {
      "localizations": {
