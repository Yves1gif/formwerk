    "Tap a line, circle or two points to add a dimension.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على خط أو دائرة أو نقطتين لإضافة بُعد."
          }
        },
        "de": {
