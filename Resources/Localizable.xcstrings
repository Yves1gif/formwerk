    "Holes go on the face you started with. Make another hole step for other faces.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنشأ الثقوب على الوجه الذي بدأت به. أنشئ خطوة ثقب أخرى للأوجه الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bohrungen kommen auf die Fläche, mit der du begonnen hast. Für andere Flächen erstellst du einen weiteren Bohrungsschritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agujeros van en la cara con la que empezaste. Crea otro paso de agujero para otras caras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trous sont placés sur la face de départ. Créez une autre étape Trou pour d’autres faces."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छेद उसी सतह पर बनते हैं जिससे आपने शुरू किया था। दूसरी सतहों के लिए अलग छेद चरण बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lubang dibuat di permukaan awal. Buat langkah lubang baru untuk permukaan lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fori vanno sulla faccia iniziale. Crea un altro passo Foro per altre facce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穴は最初に選んだ面に開きます。他の面には、別の穴ステップを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구멍은 처음 선택한 면에 만들어집니다. 다른 면에는 구멍 단계를 새로 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaten komen op het zijvlak waarmee je begon. Maak een nieuwe gatenstap voor andere zijvlakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwory trafiają na ścianę wybraną na początku. Dla innych ścian utwórz nowy krok otworu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os furos são feitos na face em que você começou. Crie outra etapa de furo para outras faces."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikler başladığınız yüze açılır. Diğer yüzler için yeni bir delik adımı oluşturun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孔会放在起始面上。其他面请另建一个孔步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "孔會放在起始面上。其他面請另外建立一個孔步驟。"
          }
        }
      }
    },
