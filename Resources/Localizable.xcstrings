    "Middle-drag orbits, Control + middle-drag pans.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السحب بالزر الأوسط يدوّر، وControl + الزر الأوسط يحرّك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittig ziehen dreht, Control + mittig ziehen verschiebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Botón central gira, Control + botón central desplaza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouton central : pivoter ; Contrôle + bouton central : déplacer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिडल-ड्रैग घुमाता है, Control + मिडल-ड्रैग खिसकाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret tengah memutar, Control + seret tengah menggeser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasto centrale ruota, Control + tasto centrale sposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中ドラッグで回転、Control+中ドラッグで移動。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 드래그는 회전, Control + 가운데 드래그는 이동입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Middelste knop draait, Control + middelste knop schuift."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środkowy obraca, Control + środkowy przesuwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Botão do meio gira, Control + botão do meio move."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta tuş döndürür, Control + orta tuş kaydırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中键拖移旋转，Control + 中键拖移平移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中鍵拖移旋轉，Control + 中鍵拖移平移。"
          }
        }
      }
    },
