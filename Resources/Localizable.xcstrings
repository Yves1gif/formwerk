    "Colours and bodies for your slicer, exact geometry for other CAD apps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الألوان والأجسام لبرنامج التقطيع، وهندسة دقيقة لتطبيقات CAD الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farben und Körper für deinen Slicer, exakte Geometrie für andere CAD-Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colores y cuerpos para tu laminador, geometría exacta para otras apps CAD."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs et corps pour votre trancheur, géométrie exacte pour les autres apps de CAO."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लाइसर के लिए रंग और बॉडी, दूसरे CAD ऐप्स के लिए सटीक ज्यामिति।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna dan bodi untuk slicer, geometri persis untuk aplikasi CAD lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori e corpi per il tuo slicer, geometria esatta per altre app CAD."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライサー向けに色とボディを保持し、他のCADアプリには正確な形状を渡せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이서에는 색상과 바디를, 다른 CAD 앱에는 정확한 형상을 전달합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleuren en lichamen voor je slicer, exacte geometrie voor andere CAD-apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolory i bryły dla slicera, dokładna geometria dla innych aplikacji CAD."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cores e corpos para seu fatiador, geometria exata para outros apps de CAD."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilimleyicin için renkler ve gövdeler, diğer CAD uygulamaları için tam geometri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为切片软件保留颜色和实体，为其他 CAD 应用提供精确几何。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為切片軟體保留顏色和實體，為其他 CAD App 提供精確幾何。"
          }
        }
      }
    },
