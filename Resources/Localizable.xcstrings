    "Three steps from idea to print. Free, no account, no limits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاث خطوات من الفكرة إلى الطباعة. مجاني، بلا حساب، بلا حدود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Schritte von der Idee zum Druck. Kostenlos, ohne Konto, ohne Limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres pasos de la idea a la impresión. Gratis, sin cuenta y sin límites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois étapes de l’idée à l’impression. Gratuit, sans compte, sans limites."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विचार से प्रिंट तक तीन चरण। मुफ़्त, बिना अकाउंट, बिना सीमा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga langkah dari ide ke cetak. Gratis, tanpa akun, tanpa batas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre passi dall’idea alla stampa. Gratis, senza account, senza limiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデアから印刷まで3ステップ。無料で、アカウント不要、制限なしです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이디어에서 출력까지 세 단계. 무료, 계정 불필요, 제한 없음."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie stappen van idee tot print. Gratis, geen account, geen limieten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy kroki od pomysłu do wydruku. Za darmo, bez konta, bez limitów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
