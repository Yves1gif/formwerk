    "Tap a side to type its exact length if you like. Then tap Done at the top.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على ضلع لكتابة طوله الدقيق إن أردت. ثم اضغط على «تم» في الأعلى."
          }
        },
        "de": {
          "stringUnit": {
