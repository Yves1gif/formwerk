    "Drag an arrow or type the distances.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب سهمًا أو اكتب المسافات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe einen Pfeil oder gib die Abstände ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una flecha o escribe las distancias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une flèche ou saisissez les distances."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीर को खींचें या दूरी टाइप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret panah atau ketik jaraknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina una freccia o inserisci le distanze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印をドラッグするか、距離を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표를 드래그하거나 거리를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een pijl of typ de afstanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij strzałkę lub wpisz odległości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma seta ou digite as distâncias."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir oku sürükleyin ya da mesafeleri yazın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动箭头或输入距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳箭頭或輸入距離。"
          }
        }
      }
    },
    "Drag the arrow or type the height. Tap more areas to add them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب السهم أو اكتب الارتفاع. اضغط على مناطق أخرى لإضافتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe den Pfeil oder gib die Höhe ein. Tippe auf weitere Bereiche, um sie hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la flecha o escribe la altura. Toca más áreas para añadirlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la flèche ou saisissez la hauteur. Touchez d’autres zones pour les ajouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीर को खींचें या ऊँचाई टाइप करें। और क्षेत्र जोड़ने के लिए उन पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret panah atau ketik tingginya. Ketuk area lain untuk menambahkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la freccia o inserisci l’altezza. Tocca altre aree per aggiungerle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印をドラッグするか、高さを入力してください。領域をタップすると追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표를 드래그하거나 높이를 입력하세요. 영역을 더 탭하면 추가됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de pijl of typ de hoogte. Tik op meer vlakken om ze toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij strzałkę lub wpisz wysokość. Stuknij kolejne obszary, aby je dodać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a seta ou digite a altura. Toque em mais áreas para adicioná-las."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oku sürükleyin ya da yüksekliği yazın. Eklemek için başka alanlara dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动箭头或输入高度。轻点更多区域可一并添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳箭頭或輸入高度。輕點更多區域即可一併加入。"
          }
        }
      }
    },
    "Drag the arrow: out adds material, in removes it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب السهم: للخارج يضيف مادة وللداخل يزيلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe den Pfeil: nach außen fügt Material hinzu, nach innen entfernt es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la flecha: hacia fuera añade material, hacia dentro lo quita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la flèche : vers l’extérieur ajoute de la matière, vers l’intérieur en retire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीर को खींचें: बाहर की ओर सामग्री जुड़ती है, अंदर की ओर हटती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret panah: ke luar menambah material, ke dalam menguranginya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la freccia: verso l’esterno aggiunge materiale, verso l’interno lo toglie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印をドラッグします。外側へで材料が増え、内側へで減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표를 드래그하세요: 바깥쪽은 재료 추가, 안쪽은 제거입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de pijl: naar buiten voegt materiaal toe, naar binnen verwijdert het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij strzałkę: na zewnątrz dodaje materiał, do środka go usuwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a seta: para fora adiciona material, para dentro remove."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oku sürükleyin: dışa doğru malzeme ekler, içe doğru çıkarır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动箭头：向外增加材料，向内去除材料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳箭頭：向外增加材料，向內移除材料。"
          }
        }
      }
    },
    "Drag the blue arrow up or type a height, then tap Done.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب السهم الأزرق للأعلى أو اكتب الارتفاع، ثم اضغط على «تم»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh den blauen Pfeil nach oben oder gib eine Höhe ein und tippe dann auf Fertig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la flecha azul hacia arriba o escribe una altura y toca Listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la flèche bleue vers le haut ou saisissez une hauteur, puis touchez OK."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीले तीर को ऊपर खींचें या ऊँचाई टाइप करें, फिर हो गया पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret panah biru ke atas atau ketik tinggi, lalu ketuk Selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la freccia blu verso l’alto o digita un’altezza, poi tocca Fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青い矢印を上にドラッグするか高さを入力して、「完了」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파란색 화살표를 위로 드래그하거나 높이를 입력한 다음 완료를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de blauwe pijl omhoog of typ een hoogte en tik op Klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij niebieską strzałkę w górę lub wpisz wysokość, a potem dotknij Gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a seta azul para cima ou digite uma altura e toque em OK."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavi oku yukarı sürükleyin veya bir yükseklik yazın, sonra Bitti'ye dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上拖动蓝色箭头或输入高度，然后轻点“完成”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上拖移藍色箭頭或輸入高度，然後輕點「完成」。"
          }
        }
      }
    },
    "Drag to turn the view, right-drag too. Scroll wheel zooms; on a trackpad two fingers turn and pinch zooms.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتدوير العرض، ويمكنك السحب بالزر الأيمن أيضًا. عجلة التمرير تكبّر وتصغّر؛ وعلى لوحة التتبع، إصبعان للتدوير والقرص للتكبير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen dreht die Ansicht, auch mit Rechtsklick. Das Mausrad zoomt; auf dem Trackpad drehen zwei Finger, Auf- und Zuziehen zoomt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para girar la vista; también con clic derecho. La rueda hace zoom; en un trackpad, dos dedos giran y el gesto de pellizco hace zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour tourner la vue, aussi avec le clic droit. La molette zoome ; sur un trackpad, deux doigts tournent et le pincement zoome."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यू घुमाने के लिए खींचें, राइट-ड्रैग भी चलता है। स्क्रॉल व्हील से ज़ूम होता है; ट्रैकपैड पर दो उँगलियों से घुमाएँ और पिंच से ज़ूम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk memutar tampilan, seret kanan juga bisa. Roda gulir untuk zoom; di trackpad dua jari memutar dan cubit untuk zoom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per ruotare la vista, anche con il tasto destro. La rotella fa lo zoom; sul trackpad due dita ruotano e il pizzico fa lo zoom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグでビューを回転します(右ドラッグでも可)。スクロールホイールでズームします。トラックパッドでは、2本指で回転、ピンチでズームします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하거나 오른쪽 버튼으로 드래그하면 보기가 회전합니다. 스크롤 휠은 확대/축소이고, 트랙패드에서는 두 손가락으로 회전하고 핀치로 확대/축소합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om de weergave te draaien, rechts slepen kan ook. Het scrollwiel zoomt; op een trackpad draai je met twee vingers en zoom je door te knijpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby obrócić widok (prawym przyciskiem też). Kółko przewijania przybliża; na gładziku dwa palce obracają, a szczypanie przybliża."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para girar a vista, ou arraste com o botão direito. A roda do mouse dá zoom; no trackpad, dois dedos giram e o gesto de pinça dá zoom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünümü döndürmek için sürükleyin, sağ tuşla da olur. Kaydırma tekerleği yakınlaştırır; izleme dörtgeninde iki parmak döndürür, kıstırma yakınlaştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动或右键拖动可旋转视图。滚轮缩放；在触控板上双指旋转，捏合缩放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳或按右鍵拖曳可旋轉檢視。滾輪可縮放；在觸控板上以雙指旋轉，捏合縮放。"
          }
        }
      }
    },
    "Draw a closed shape in a sketch first, then tap it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم شكلًا مغلقًا في رسم أولًا، ثم اضغط عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne zuerst eine geschlossene Form in einer Skizze und tippe sie dann an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero dibuja una forma cerrada en un boceto y luego tócala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez d’abord une forme fermée dans une esquisse, puis touchez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले स्केच में एक बंद आकृति बनाएँ, फिर उस पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar bentuk tertutup di sketsa dulu, lalu ketuk bentuk itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna prima una forma chiusa in uno schizzo, poi toccala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずスケッチで閉じた図形を描いてから、タップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 스케치에서 닫힌 도형을 그린 다음 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken eerst een gesloten vorm in een schets en tik er dan op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw narysuj zamknięty kształt w szkicu, a potem go stuknij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe primeiro uma forma fechada em um esboço e depois toque nela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir eskizde kapalı bir şekil çizin, sonra ona dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在草图中绘制封闭形状，然后轻点它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在草圖中繪製封閉形狀，然後輕點它。"
          }
        }
      }
    },
    "Draw a closed shape. Tap a line to type its exact size.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم شكلًا مغلقًا. اضغط على خط لكتابة مقاسه بدقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne eine geschlossene Form. Tippe auf eine Linie, um ihr genaues Mass einzugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja una forma cerrada. Toca una línea para escribir su medida exacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez une forme fermée. Touchez une ligne pour saisir sa taille exacte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बंद आकृति बनाएँ। सटीक माप टाइप करने के लिए रेखा पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar bentuk tertutup. Ketuk garis untuk mengetik ukuran tepatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna una forma chiusa. Tocca una linea per inserire la misura esatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた図形を描きます。線をタップすると、正確なサイズを入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫힌 도형을 그리세요. 선을 탭하면 정확한 크기를 입력할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken een gesloten vorm. Tik op een lijn om de exacte maat te typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narysuj zamknięty kształt. Stuknij linię, aby wpisać jej dokładny wymiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe uma forma fechada. Toque em uma linha para digitar a medida exata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı bir şekil çiz. Tam ölçüsünü girmek için bir çizgiye dokun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画一个封闭形状。轻点线条可输入精确尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製一個封閉形狀。輕點線條即可輸入精確尺寸。"
          }
        }
      }
    },
