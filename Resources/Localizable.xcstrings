    "%lld bodies don't touch the print bed. Join them or add supports.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld أجسام لا تلامس سرير الطباعة. اربطها معًا أو أضف دعامات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Körper berühren das Druckbett nicht. Vereine sie oder füge Stützen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cuerpos no tocan la cama de impresión. Únelos o añade soportes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld corps ne touchent pas le plateau. Unissez-les ou ajoutez des supports."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld बॉडी प्रिंट बेड को नहीं छूतीं। उन्हें जोड़ें या सपोर्ट जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bodi tidak menyentuh alas cetak. Gabungkan atau tambahkan penyangga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld corpi non toccano il piatto. Uniscili o aggiungi supporti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個のボディがビルドプレートに接していません。結合するか、サポートを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바디 %lld개가 출력 베드에 닿지 않습니다. 결합하거나 서포트를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lichamen raken het printbed niet. Voeg ze samen of voeg support toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bryły bez kontaktu ze stołem: %lld. Połącz je lub dodaj podpory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld corpos não tocam a mesa de impressão. Una-os ou adicione suportes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gövde baskı tablasına değmiyor. Birleştirin ya da destek ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个实体未接触打印平台。请合并或添加支撑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個實體未接觸列印平台。請合併或加入支撐。"
          }
        }
      }
    },
