    "Pay once. Yours on iPad, iPhone and Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع مرة واحدة. لك على iPad وiPhone وMac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal zahlen. Deins auf iPad, iPhone und Mac."
          }
        },
