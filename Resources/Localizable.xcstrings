    "Tip: to rest a part on a certain face, select that face and use Lay flat.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصيحة: لتثبيت القطعة على وجه معيّن، حدّد ذلك الوجه واستخدم «وضع مسطّح»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Damit ein Teil auf einer bestimmten Fläche liegt, wähle diese Fläche aus und nutze Flach hinlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: para apoyar una pieza sobre una cara concreta, selecciona esa cara y usa Apoyar plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : pour poser une pièce sur une face précise, sélectionnez cette face et utilisez Poser à plat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव: पार्ट को किसी ख़ास सतह पर रखने के लिए वह सतह चुनें और सपाट रखें इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: untuk menumpukan bagian pada sisi tertentu, pilih sisi itu lalu gunakan Rebahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: per appoggiare un pezzo su una certa faccia, selezionala e usa Appoggia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント:特定の面を下にして置くには、その面を選んで「平らに置く」を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 부품을 특정 면이 바닥에 닿게 놓으려면 그 면을 선택하고 평평하게 놓기를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: om een onderdeel op een bepaald vlak te laten rusten, selecteer dat vlak en gebruik Plat leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: aby oprzeć część na wybranej ściance, zaznacz ją i użyj Połóż płasko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: para apoiar uma peça em uma face específica, selecione essa face e use Deitar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: bir parçayı belirli bir yüzeyine yatırmak için o yüzeyi seçin ve Düz yatır'ı kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：若要让零件以某个面朝下，请选中该面并使用“平放”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：若要讓零件以某個面朝下，請選取該面並使用「平放」。"
          }
        }
      }
    },
    "Too big for the %@ (%@ × %@ × %@ mm).": {
