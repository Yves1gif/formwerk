    "Apple Pencil draws and drags. One finger orbits, two fingers pan and zoom.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسم Apple Pencil ويسحب. إصبع واحدة للتدوير، وإصبعان للتحريك والتكبير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Apple Pencil zeichnet und zieht. Ein Finger dreht, zwei Finger verschieben und zoomen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple Pencil dibuja y arrastra. Un dedo gira, dos dedos desplazan y hacen zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple Pencil dessine et déplace. Un doigt fait pivoter, deux doigts déplacent et zooment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil ड्रॉ और ड्रैग करता है। एक उंगली घुमाती है, दो उंगलियाँ खिसकाती और ज़ूम करती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil menggambar dan menyeret. Satu jari memutar, dua jari menggeser dan memperbesar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil disegna e trascina. Un dito ruota, due dita spostano e zoomano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencilで描画とドラッグ。1本指で回転、2本指で移動とズーム。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil로 그리고 드래그합니다. 한 손가락은 회전, 두 손가락은 이동과 확대/축소입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil tekent en sleept. Eén vinger draait, twee vingers schuiven en zoomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil rysuje i przeciąga. Jeden palec obraca, dwa palce przesuwają i powiększają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Pencil desenha e arrasta. Um dedo gira, dois dedos movem e dão zoom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil çizer ve sürükler. Tek parmak döndürür, iki parmak kaydırır ve yakınlaştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
