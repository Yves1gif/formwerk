    "Check it, then send 3MF to Bambu Studio or PrusaSlicer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحصه، ثم أرسل ملف 3MF إلى Bambu Studio أو PrusaSlicer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe es und schick 3MF an Bambu Studio oder PrusaSlicer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruébalo y envía el 3MF a Bambu Studio o PrusaSlicer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez-le, puis envoyez le 3MF à Bambu Studio ou PrusaSlicer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे जाँचें, फिर 3MF को Bambu Studio या PrusaSlicer में भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa, lalu kirim 3MF ke Bambu Studio atau PrusaSlicer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllalo, poi invia il 3MF a Bambu Studio o PrusaSlicer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認してから、3MFをBambu StudioまたはPrusaSlicerに送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사한 다음 3MF를 Bambu Studio 또는 PrusaSlicer로 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer het en stuur de 3MF naar Bambu Studio of PrusaSlicer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź go, a potem wyślij 3MF do Bambu Studio lub PrusaSlicer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique e depois envie o 3MF para o Bambu Studio ou o PrusaSlicer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol et, ardından 3MF’yi Bambu Studio veya PrusaSlicer’a gönder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查后，将 3MF 发送到 Bambu Studio 或 PrusaSlicer。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查後，將 3MF 傳送到 Bambu Studio 或 PrusaSlicer。"
          }
        }
      }
    },
