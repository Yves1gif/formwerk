        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평평한 면을 탭하면 그 면을 기준으로 대칭되고, 기본 평면을 선택할 수도 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
