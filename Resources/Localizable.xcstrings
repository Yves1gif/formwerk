    "Repeat bodies, hollow them out to save filament, cut big parts to fit your printer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّر الأجسام، وفرّغها لتوفير الخيوط، وقسّم القطع الكبيرة لتناسب طابعتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Körper wiederholen, aushöhlen um Filament zu sparen, grosse Teile passend für deinen Drucker zerteilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite cuerpos, vacíalos para ahorrar filamento y corta piezas grandes para que quepan en tu impresora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez des corps, évidez-les pour économiser du filament, coupez les grandes pièces à la taille de votre imprimante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बॉडी दोहराएँ, फ़िलामेंट बचाने के लिए खोखला करें, बड़े पार्ट को प्रिंटर के हिसाब से काटें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi bodi, buat cangkang untuk hemat filamen, belah komponen besar agar muat di printermu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti i corpi, svuotali per risparmiare filamento, taglia le parti grandi per la tua stampante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボディを繰り返し、中空にしてフィラメントを節約し、大きなパーツをプリンターに収まるよう分割できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바디를 반복하고, 속을 비워 필라멘트를 아끼고, 큰 부품을 프린터에 맞게 나누세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaal lichamen, hol ze uit om filament te besparen, snij grote onderdelen zodat ze in je printer passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powielaj bryły, wydrążaj je, by oszczędzić filament, dziel duże części, by zmieściły się w drukarce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita corpos, deixe-os ocos para economizar filamento e corte peças grandes para caber na sua impressora."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gövdeleri tekrarla, filament tasarrufu için içlerini boşalt, büyük parçaları yazıcına sığacak şekilde böl."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复实体、抽壳以节省耗材，把大零件切分成适合打印机的尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複實體、抽殼以節省線材，把大零件切分成適合印表機的尺寸。"
          }
        }
      }
    },
