          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikirden baskıya üç adım. Ücretsiz, hesapsız, sınırsız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从创意到打印只需三步。免费、无需账户、没有限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
