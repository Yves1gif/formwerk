    "Pull the arrow to make it solid. Round edges, add holes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب السهم لتحويله إلى مجسم. دوّر الحواف وأضف ثقوبًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh am Pfeil, um es massiv zu machen. Runde Kanten ab, füge Löcher hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira de la flecha para hacerlo sólido. Redondea aristas y añade agujeros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez la flèche pour le rendre solide. Arrondissez les arêtes, ajoutez des trous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठोस बनाने के लिए तीर को खींचें। किनारे गोल करें, छेद जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik panah untuk membuatnya padat. Bulatkan tepi, tambahkan lubang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la freccia per renderlo solido. Arrotonda gli spigoli, aggiungi fori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印を引いてソリッドにします。エッジを丸めたり、穴を追加したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표를 당겨 입체로 만드세요. 모서리를 둥글게 하고 구멍을 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek aan de pijl om het massief te maken. Rond randen af, voeg gaten toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pociągnij strzałkę, aby nadać bryłę. Zaokrąglaj krawędzie, dodawaj otwory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe a seta para criar o sólido. Arredonde arestas, adicione furos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katı yapmak için oku çek. Kenarları yuvarla, delik ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动箭头使其成为实体。倒圆边缘、添加孔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳箭頭使其成為實體。可將邊緣倒圓角、加入孔。"
          }
        }
      }
    },
