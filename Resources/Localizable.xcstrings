    "Waiting for approval. Pro unlocks by itself once it's approved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار الموافقة. يُفتح Pro تلقائيًا بعد الموافقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf Freigabe. Pro wird automatisch freigeschaltet, sobald sie erteilt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Pro se desbloquea solo en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’approbation. Pro se débloque tout seul une fois l’achat approuvé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंज़ूरी का इंतज़ार है। मंज़ूरी मिलते ही Pro अपने आप अनलॉक हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu persetujuan. Pro terbuka sendiri setelah disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione. Pro si sblocca da solo appena viene approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を待っています。承認されるとProは自動的にロック解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인을 기다리는 중입니다. 승인되면 Pro가 자동으로 잠금 해제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht op goedkeuring. Pro wordt vanzelf ontgrendeld zodra het is goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekamy na zgodę. Pro odblokuje się samo, gdy zakup zostanie zatwierdzony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. O Pro é liberado sozinho assim que for aprovado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay bekleniyor. Onaylandığında Pro kendiliğinden açılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待批准。批准后 Pro 会自动解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待批准。批准後 Pro 會自動解鎖。"
          }
        }
      }
    },
