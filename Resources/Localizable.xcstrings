          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsterseniz bir kenara dokunup tam uzunluğunu yazın. Sonra üstteki Bitti'ye dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
