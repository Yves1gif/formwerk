          }
        }
      }
    },
    "Tap to select. Drag points to move them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط للتحديد. اسحب النقاط لنقلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zum Auswählen. Ziehe Punkte, um sie zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para seleccionar. Arrastra los puntos para moverlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour sélectionner. Faites glisser les points pour les déplacer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनने के लिए टैप करें। बिंदुओं को खिसकाने के लिए खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk memilih. Seret titik untuk memindahkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per selezionare. Trascina i punti per spostarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして選択します。点をドラッグすると移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 선택하세요. 점을 드래그하면 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om te selecteren. Sleep punten om ze te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby zaznaczyć. Przeciągaj punkty, aby je przesunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para selecionar. Arraste os pontos para movê-los."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçmek için dokunun. Taşımak için noktaları sürükleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点以选择。拖动点可移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點以選取。拖曳點即可移動。"
          }
        }
      }
    },
    "Tap two faces, edges or bodies.": {
