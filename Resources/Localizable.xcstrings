    "Some constraints contradict each other (red).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض القيود تتعارض مع بعضها (باللون الأحمر)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Bedingungen widersprechen sich (rot)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas restricciones se contradicen entre sí (rojo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines contraintes se contredisent (en rouge)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ बंधन एक-दूसरे का विरोध करते हैं (लाल)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa batasan saling bertentangan (merah)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni vincoli sono in conflitto (in rosso)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の拘束が互いに矛盾しています(赤)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 구속 조건이 서로 충돌합니다 (빨간색)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige beperkingen spreken elkaar tegen (rood)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre wiązania są ze sobą sprzeczne (czerwone)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas restrições se contradizem (em vermelho)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı kısıtlamalar birbiriyle çelişiyor (kırmızı)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分约束相互冲突（红色）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分約束相互衝突（紅色）。"
          }
        }
      }
    },
    "Some walls are thinner than %@. They may not print.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض الجدران أرق من %@. قد لا تُطبع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Wände sind dünner als %@. Sie werden eventuell nicht gedruckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas paredes son más delgadas que %@. Puede que no se impriman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines parois sont plus fines que %@. Elles risquent de ne pas s’imprimer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ दीवारें %@ से पतली हैं। वे प्रिंट नहीं हो सकतीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa dinding lebih tipis dari %@. Mungkin tidak tercetak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune pareti sono più sottili di %@. Potrebbero non stamparsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@より薄い壁があります。印刷できない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@보다 얇은 벽이 있습니다. 출력되지 않을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige wanden zijn dunner dan %@. Ze printen mogelijk niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre ścianki są cieńsze niż %@. Mogą się nie wydrukować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas paredes são mais finas que %@. Elas podem não ser impressas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı duvarlar %@ değerinden ince. Basılamayabilirler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分壁厚小于 %@，可能无法打印。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分壁厚小於 %@，可能無法列印。"
          }
        }
      }
    },
