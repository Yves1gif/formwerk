    "That size doesn't fit the other constraints.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المقاس لا يتوافق مع القيود الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Größe passt nicht zu den anderen Bedingungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese tamaño no encaja con las demás restricciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette taille n’est pas compatible avec les autres contraintes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह माप दूसरे बंधनों के साथ मेल नहीं खाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran itu tidak cocok dengan batasan lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa dimensione non è compatibile con gli altri vincoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイズは他の拘束と両立しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 크기는 다른 구속 조건과 맞지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die maat past niet bij de andere beperkingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten rozmiar nie pasuje do pozostałych wiązań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse tamanho não é compatível com as outras restrições."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu boyut diğer kısıtlamalarla uyuşmuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该尺寸与其他约束不符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該尺寸與其他約束不符。"
          }
        }
      }
    },
    "The area is selected. Tap Extrude in the bar at the bottom.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديد المنطقة. اضغط على «بثق» في الشريط السفلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fläche ist ausgewählt. Tippe in der Leiste unten auf Extrudieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El área está seleccionada. Toca Extruir en la barra inferior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone est sélectionnée. Touchez Extruder dans la barre du bas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षेत्र चुना गया है। नीचे की बार में एक्सट्रूड पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Area terpilih. Ketuk Ekstrusi di bilah bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’area è selezionata. Tocca Estrudi nella barra in basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領域が選択されました。下のバーの「押し出し」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역이 선택되었습니다. 아래쪽 막대에서 돌출을 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vlak is geselecteerd. Tik op Extruderen in de balk onderaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obszar jest zaznaczony. Dotknij Wyciągnij na dolnym pasku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área está selecionada. Toque em Extrudar na barra inferior."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alan seçildi. Alttaki çubukta Ekstrüzyon'a dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区域已选中。轻点底部栏中的“拉伸”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域已選取。輕點底部列中的「擠出」。"
          }
        }
      }
    },
    "The body for this step no longer exists.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجسم الخاص بهذه الخطوة لم يعد موجودًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Körper für diesen Schritt existiert nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cuerpo de este paso ya no existe."
          }
        },
