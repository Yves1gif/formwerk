          }
        }
      }
    },
    "Too big for the %@ this way round, but it fits turned by 90°.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكبر من أن يناسب %@ بهذا الاتجاه، لكنه يناسبه عند تدويره 90°."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So herum zu groß für den %@, aber um 90° gedreht passt es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado grande para %@ así, pero cabe girado 90°."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop grand pour %@ dans ce sens, mais tient une fois tourné de 90°."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में इस दिशा में बहुत बड़ा है, पर 90° घुमाने पर समा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu besar untuk %@ dengan posisi ini, tetapi muat jika diputar 90°."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo grande per %@ in questo verso, ma ruotato di 90° ci sta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この向きでは%@には大きすぎますが、90°回転すると収まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 방향으로는 %@에 비해 너무 크지만, 90° 돌리면 들어갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo te groot voor de %@, maar 90° gedraaid past het wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym ułożeniu za duże dla %@, ale po obróceniu o 90° się mieści."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grande demais para a %@ nesta posição, mas cabe girado em 90°."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yönde %@ için çok büyük, ama 90° çevrilince sığıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按此方向超出 %@ 的尺寸，但旋转 90° 后可以放下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依此方向超出 %@ 的尺寸，但旋轉 90° 後可以放下。"
          }
        }
      }
    },
