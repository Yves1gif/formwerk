    "Tap Print at the top right to check your part and export it for your slicer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على «طباعة» في أعلى اليمين لفحص قطعتك وتصديرها إلى برنامج التقطيع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf Drucken, um dein Teil zu prüfen und für deinen Slicer zu exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Imprimir arriba a la derecha para revisar tu pieza y exportarla a tu slicer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Imprimer en haut à droite pour vérifier votre pièce et l’exporter vers votre slicer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पार्ट जाँचने और अपने स्लाइसर के लिए एक्सपोर्ट करने के लिए ऊपर दाईं ओर प्रिंट पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Cetak di kanan atas untuk memeriksa bagian Anda dan mengekspornya ke slicer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Stampa in alto a destra per controllare il pezzo ed esportarlo per il tuo slicer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「印刷」をタップすると、パーツを確認してスライサー用に書き出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위의 출력을 탭하면 부품을 확인하고 슬라이서용으로 내보낼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik rechtsboven op Print om je onderdeel te controleren en te exporteren voor je slicer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij Druk w prawym górnym rogu, aby sprawdzić część i wyeksportować ją do slicera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Imprimir no canto superior direito para verificar sua peça e exportá-la para o seu slicer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçanızı kontrol edip dilimleyiciniz için dışa aktarmak üzere sağ üstteki Baskı'ya dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点右上角的“打印”，检查零件并导出到切片软件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點右上角的「列印」，檢查零件並匯出給切片軟體。"
          }
        }
      }
    },
    "Tap Sketch to start. You will draw on the ground.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على رسم للبدء. سترسم على الأرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Skizze, um zu beginnen. Du zeichnest auf den Boden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Boceto para empezar. Dibujarás sobre el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Esquisse pour commencer. Vous dessinez sur le sol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए स्केच पर टैप करें। आप ज़मीन पर ड्रॉ करेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Sketsa untuk mulai. Kamu menggambar di bidang dasar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Schizzo per iniziare. Disegnerai sul piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケッチをタップして始めます。地面に描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스케치를 탭하여 시작하세요. 바닥에 그리게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Schets om te beginnen. Je tekent op de grond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Szkic, aby zacząć. Rysujesz na podłożu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Esboço para começar. Você desenha no chão."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için Eskiz'e dokun. Zemine çizeceksin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“草图”开始。你将在地面上绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「草圖」開始。你會在地面上繪製。"
          }
        }
      }
    },
    "Tap a flat face first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على وجه مسطح أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zuerst auf eine ebene Fläche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero toca una cara plana."
          }
        },
        "fr": {
