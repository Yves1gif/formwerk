    "Single keys work while no text field is being edited. Drawing keys start a sketch when none is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل المفاتيح المفردة ما دام لا يتم تحرير حقل نص. تبدأ مفاتيح الرسم رسمًا جديدًا إذا لم يكن هناك رسم مفتوح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelne Tasten wirken, solange kein Textfeld bearbeitet wird. Zeichentasten starten eine Skizze, wenn keine offen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas sueltas funcionan mientras no se edita ningún campo de texto. Las teclas de dibujo inician un boceto si no hay ninguno abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches simples fonctionnent tant qu’aucun champ de texte n’est en cours de modification. Les touches de dessin ouvrent une esquisse si aucune n’est ouverte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई टेक्स्ट फ़ील्ड एडिट नहीं हो रहा हो, तब सिंगल कुंजियाँ काम करती हैं। कोई स्केच खुला न हो तो ड्रॉइंग कुंजियाँ नया स्केच शुरू करती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol tunggal berfungsi saat tidak ada kolom teks yang diedit. Tombol gambar memulai sketsa jika belum ada yang terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti singoli funzionano quando non stai modificando un campo di testo. I tasti di disegno avviano uno schizzo se non ce n’è uno aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストフィールドを編集していないときは単一キーが使えます。スケッチが開いていなければ、描画キーで新しいスケッチを始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 필드를 편집하지 않을 때 단일 키가 작동합니다. 열린 스케치가 없으면 그리기 키로 스케치를 시작합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Losse toetsen werken zolang er geen tekstveld wordt bewerkt. Tekentoetsen starten een schets als er geen open is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojedyncze klawisze działają, gdy nie edytujesz pola tekstowego. Klawisze rysowania otwierają szkic, jeśli żaden nie jest otwarty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas simples funcionam quando nenhum campo de texto está sendo editado. As teclas de desenho iniciam um esboço se nenhum estiver aberto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek tuşlar, bir metin alanı düzenlenmezken çalışır. Çizim tuşları, açık eskiz yoksa yeni bir eskiz başlatır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未编辑文本栏时可使用单键。未打开草图时，绘图键会新建草图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未編輯文字欄位時可使用單鍵。未開啟草圖時，繪圖鍵會新增草圖。"
          }
        }
      }
    },
