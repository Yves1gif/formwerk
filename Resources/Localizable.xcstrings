    "Rough guide with 2 walls and 15% infill. Your slicer gives the exact amount.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير تقريبي مع جدارين وحشو 15%. يعطيك برنامج التقطيع الكمية الدقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grober Richtwert mit 2 Wänden und 15 % Füllung. Dein Slicer nennt die genaue Menge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor aproximado con 2 paredes y 15 % de relleno. Tu laminador da la cantidad exacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation approximative avec 2 parois et 15 % de remplissage. Votre slicer donne la quantité exacte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2 दीवारों और 15% इन्फ़िल के साथ मोटा अंदाज़ा। सटीक मात्रा आपका slicer बताएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan kasar dengan 2 dinding dan isian 15%. Slicer Anda memberi jumlah pastinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima indicativa con 2 pareti e riempimento al 15%. Il tuo slicer indica la quantità esatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁2枚、インフィル15%での大まかな目安です。正確な量はスライサーで確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽 2겹, 채움 15% 기준의 대략적인 값입니다. 정확한 양은 슬라이서에서 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale indicatie met 2 wanden en 15% vulling. Je slicer geeft de exacte hoeveelheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przybliżenie dla 2 ścianek i 15% wypełnienia. Dokładną ilość poda slicer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor aproximado com 2 paredes e 15% de preenchimento. Seu fatiador mostra a quantidade exata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 duvar ve yüzde 15 dolguyla kaba tahmin. Kesin miktarı dilimleyiciniz verir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 2 层墙和 15% 填充粗略估算，精确用量以切片软件为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 2 層外牆和 15% 填充粗略估算，精確用量以切片軟體為準。"
          }
        }
      }
    },
