          "stringUnit": {
            "state": "translated",
            "value": "请先轻点一个平面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先輕點一個平面。"
          }
        }
      }
    },
    "Tap a flat face to mirror across it, or pick a main plane.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على وجه مسطح للانعكاس عبره، أو اختر مستوى رئيسيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine ebene Fläche, um daran zu spiegeln, oder wähle eine Hauptebene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una cara plana para hacer la simetría respecto a ella, o elige un plano principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une face plane pour l’utiliser comme miroir, ou choisissez un plan principal."
