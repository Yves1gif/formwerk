    "Copies the body in a row or around an axis.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسخ الجسم في صف أو حول محور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert den Körper in einer Reihe oder um eine Achse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el cuerpo en fila o alrededor de un eje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie le corps en ligne ou autour d’un axe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बॉडी की प्रतियाँ एक पंक्ति में या अक्ष के चारों ओर बनाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyalin bodi dalam satu baris atau mengelilingi sumbu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia il corpo in fila o attorno a un asse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボディを一列に、または軸のまわりにコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바디를 한 줄로 또는 축을 중심으로 복사합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieert het lichaam in een rij of rond een as."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuje bryłę w rzędzie lub wokół osi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia o corpo em linha ou ao redor de um eixo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gövdeyi bir sıra hâlinde ya da bir eksen etrafında kopyalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿直线或绕轴复制实体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿直線或繞軸複製實體。"
          }
        }
      }
    },
