        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca prima una faccia piana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず平らな面をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 평평한 면을 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik eerst op een vlak zijvlak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw stuknij płaską ścianę."
          }
        },
