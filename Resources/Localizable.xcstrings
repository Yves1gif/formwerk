    "Sketching, all modelling tools, templates, the print check and STL export. No limits, no ads.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرسم، وكل أدوات النمذجة، والقوالب، وفحص الطباعة، والتصدير إلى STL. بلا حدود وبلا إعلانات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skizzieren, alle Modellierwerkzeuge, Vorlagen, die Druckprüfung und der STL-Export. Ohne Limits, ohne Werbung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bocetos, todas las herramientas de modelado, las plantillas, la revisión de impresión y la exportación STL. Sin límites y sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquisses, tous les outils de modélisation, les modèles, la vérification d’impression et l’export STL. Sans limites, sans publicité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्केचिंग, सभी मॉडलिंग टूल, टेम्पलेट, प्रिंट जाँच और STL एक्सपोर्ट। कोई सीमा नहीं, कोई विज्ञापन नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuat sketsa, semua alat pemodelan, templat, pemeriksaan cetak, dan ekspor STL. Tanpa batas, tanpa iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schizzi, tutti gli strumenti di modellazione, i modelli, il controllo di stampa e l’esportazione STL. Senza limiti, senza pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケッチ、すべてのモデリングツール、テンプレート、印刷チェック、STL書き出し。制限なし、広告なしです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스케치, 모든 모델링 도구, 템플릿, 출력 점검, STL 내보내기. 제한도 광고도 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schetsen, alle modelleergereedschappen, sjablonen, de printcontrole en STL-export. Geen limieten, geen advertenties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szkicowanie, wszystkie narzędzia do modelowania, szablony, kontrola wydruku i eksport STL. Bez limitów, bez reklam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esboços, todas as ferramentas de modelagem, modelos, a verificação de impressão e a exportação STL. Sem limites, sem anúncios."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eskiz, tüm modelleme araçları, şablonlar, baskı kontrolü ve STL dışa aktarma. Sınırsız, reklamsız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草图、所有建模工具、模板、打印检查和 STL 导出。没有限制，没有广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草圖、所有建模工具、範本、列印檢查和 STL 輸出。沒有限制，沒有廣告。"
          }
        }
      }
    },
