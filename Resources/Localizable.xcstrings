    "Tap on the face to add more holes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الوجه لإضافة ثقوب أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Fläche, um weitere Bohrungen hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la cara para añadir más agujeros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la face pour ajouter d’autres trous."
          }
        },
        "hi": {
