    "Formwerk is free and open source (MPL-2.0).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk مجاني ومفتوح المصدر (MPL-2.0)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk ist kostenlos und Open Source (MPL-2.0)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk es gratuito y de código abierto (MPL-2.0)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk est gratuit et open source (MPL-2.0)."
          }
        },
        "hi": {
