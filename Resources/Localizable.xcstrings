    "Spins the area around an axis. Pick a sketch line as axis, or use the sketch's vertical axis.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدير المنطقة حول محور. اختر خط رسم كمحور، أو استخدم المحور الرأسي للرسم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreht den Bereich um eine Achse. Wähle eine Skizzenlinie als Achse oder nutze die vertikale Achse der Skizze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace girar el área alrededor de un eje. Elige una línea del boceto como eje o usa el eje vertical del boceto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait tourner la zone autour d’un axe. Choisissez une ligne d’esquisse comme axe ou utilisez l’axe vertical de l’esquisse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षेत्र को अक्ष के चारों ओर घुमाता है। अक्ष के रूप में कोई स्केच रेखा चुनें, या स्केच की ऊर्ध्वाधर अक्ष इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutar area mengelilingi sumbu. Pilih garis sketsa sebagai sumbu, atau gunakan sumbu vertikal sketsa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota l’area attorno a un asse. Scegli una linea di schizzo come asse o usa l’asse verticale dello schizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領域を軸のまわりに回転させます。スケッチの線を軸として選ぶか、スケッチの垂直軸を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역을 축을 중심으로 회전시킵니다. 스케치 선을 축으로 선택하거나 스케치의 수직축을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait het vlak rond een as. Kies een schetslijn als as of gebruik de verticale as van de schets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraca obszar wokół osi. Wybierz linię szkicu jako oś lub użyj pionowej osi szkicu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira a área ao redor de um eixo. Escolha uma linha do esboço como eixo ou use o eixo vertical do esboço."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alanı bir eksen etrafında döndürür. Eksen olarak bir eskiz çizgisi seçin ya da eskizin dikey eksenini kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将区域绕轴旋转。选择一条草图线作为轴，或使用草图的竖直轴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將區域繞軸旋轉。選取一條草圖線作為軸，或使用草圖的垂直軸。"
          }
        }
      }
    },
