    "Finds the way round with the least overhang.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجد الاتجاه الذي فيه أقل بروز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet die Ausrichtung mit dem wenigsten Überhang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra la orientación con menos voladizo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve l’orientation avec le moins de porte-à-faux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे कम ओवरहैंग वाला रुख़ ढूँढता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menemukan posisi dengan overhang paling sedikit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova l’orientamento con meno sbalzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーバーハングが最も少ない向きを見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오버행이 가장 적은 방향을 찾아 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vindt de stand met de minste overhang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajduje ułożenie z najmniejszym nawisem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra a orientação com menos balanço."
          }
        },
