    "On an iPhone Duo, just unfold it for the full editor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على iPhone Duo، افتحه فقط لتحصل على المحرّر الكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone Duo einfach aufklappen für den ganzen Editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un iPhone Duo, despliégalo para usar el editor completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un iPhone Duo, dépliez-le simplement pour l’éditeur complet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duo पर पूरे एडिटर के लिए बस उसे खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iPhone Duo, cukup buka lipatannya untuk editor lengkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPhone Duo, aprilo per avere l’editor completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duoなら、開くだけですべての機能を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duo에서는 펼치기만 하면 전체 편집기를 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een iPhone Duo vouw je hem gewoon open voor de volledige editor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iPhonie Duo po prostu go rozłóż, aby mieć pełny edytor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone Duo, basta desdobrá-lo para usar o editor completo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duo’da tam düzenleyici için cihazı açman yeterli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone Duo 上，展开即可使用完整编辑器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone Duo 上，展開即可使用完整編輯器。"
          }
        }
      }
    },
