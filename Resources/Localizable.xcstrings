          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un lado para escribir su longitud exacta si quieres. Luego toca Listo arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un côté pour saisir sa longueur exacte si vous le souhaitez. Puis touchez OK en haut."
