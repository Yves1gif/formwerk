    "Shortcuts: K sketch, L line, R rectangle, C circle, D dimension, Esc to stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاختصارات: K رسم، L خط، R مستطيل، C دائرة، D بُعد، Esc للإيقاف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle: K Skizze, L Linie, R Rechteck, C Kreis, D Bemaßung, Esc zum Beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos: K boceto, L línea, R rectángulo, C círculo, D cota, Esc para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis : K esquisse, L ligne, R rectangle, C cercle, D cote, Esc pour arrêter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट: K स्केच, L रेखा, R आयत, C वृत्त, D माप, रुकने के लिए Esc।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan: K sketsa, L garis, R persegi panjang, C lingkaran, D dimensi, Esc untuk berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorciatoie: K schizzo, L linea, R rettangolo, C cerchio, D quota, Esc per terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット: K スケッチ、L 線、R 長方形、C 円、D 寸法、Esc 中止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키: K 스케치, L 선, R 직사각형, C 원, D 치수, Esc 중지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneltoetsen: K schets, L lijn, R rechthoek, C cirkel, D maat, Esc om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skróty: K szkic, L linia, R prostokąt, C okrąg, D wymiar, Esc kończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atalhos: K esboço, L linha, R retângulo, C círculo, D cota, Esc para parar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar: K eskiz, L çizgi, R dikdörtgen, C daire, D ölçü, Esc durdurur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键：K 草图，L 直线，R 矩形，C 圆，D 尺寸，Esc 停止。"
