        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변을 탭하면 정확한 길이를 입력할 수 있습니다. 그런 다음 위쪽의 완료를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
