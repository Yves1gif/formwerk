    "Best for Bambu Studio, PrusaSlicer and OrcaSlicer: keeps units, colours and bodies.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأفضل لـ Bambu Studio وPrusaSlicer وOrcaSlicer: يحافظ على الوحدات والألوان والأجسام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal für Bambu Studio, PrusaSlicer und OrcaSlicer: behält Einheiten, Farben und Körper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para Bambu Studio, PrusaSlicer y OrcaSlicer: conserva unidades, colores y cuerpos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour Bambu Studio, PrusaSlicer et OrcaSlicer : conserve unités, couleurs et corps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Studio, PrusaSlicer और OrcaSlicer के लिए सबसे अच्छा: इकाइयाँ, रंग और बॉडी सुरक्षित रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terbaik untuk Bambu Studio, PrusaSlicer, dan OrcaSlicer: menjaga satuan, warna, dan bodi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideale per Bambu Studio, PrusaSlicer e OrcaSlicer: mantiene unità, colori e corpi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Studio、PrusaSlicer、OrcaSlicerに最適です。単位、色、ボディが保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Studio, PrusaSlicer, OrcaSlicer에 가장 적합: 단위, 색상, 바디가 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het beste voor Bambu Studio, PrusaSlicer en OrcaSlicer: behoudt eenheden, kleuren en lichamen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepszy dla Bambu Studio, PrusaSlicer i OrcaSlicer: zachowuje jednostki, kolory i bryły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para Bambu Studio, PrusaSlicer e OrcaSlicer: mantém unidades, cores e corpos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bambu Studio, PrusaSlicer ve OrcaSlicer için en iyisi: birimleri, renkleri ve gövdeleri korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最适合 Bambu Studio、PrusaSlicer 和 OrcaSlicer：保留单位、颜色和实体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最適合 Bambu Studio、PrusaSlicer 和 OrcaSlicer：保留單位、顏色和實體。"
          }
        }
      }
    },
    "Blue parts can still move. Add dimensions to fix them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجزاء الزرقاء ما زالت تتحرك. أضف أبعادًا لتثبيتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blaue Teile sind noch beweglich. Füge Bemaßungen hinzu, um sie festzulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes azules aún pueden moverse. Añade cotas para fijarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments bleus peuvent encore bouger. Ajoutez des cotes pour les fixer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीले हिस्से अभी भी हिल सकते हैं। उन्हें स्थिर करने के लिए माप जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian biru masih bisa bergerak. Tambahkan dimensi untuk menguncinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parti blu possono ancora muoversi. Aggiungi quote per fissarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青い部分はまだ動かせます。寸法を追加して固定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파란색 부분은 아직 움직일 수 있습니다. 치수를 추가해 고정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blauwe delen kunnen nog bewegen. Voeg maten toe om ze vast te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niebieskie elementy mogą się jeszcze przesuwać. Dodaj wymiary, aby je ustalić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes azuis ainda podem se mover. Adicione cotas para fixá-las."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavi parçalar hâlâ hareket edebilir. Sabitlemek için ölçü ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝色部分仍可移动。添加尺寸以将其固定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍色部分仍可移動。加入尺寸即可將其固定。"
          }
        }
      }
    },
    "Bodies": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجسام"
          }
