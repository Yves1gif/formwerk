    "Formwerk Pro is unlocked. Thank you!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فتح Formwerk Pro. شكرًا لك!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk Pro ist freigeschaltet. Danke!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk Pro está desbloqueado. ¡Gracias!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formwerk Pro est débloqué. Merci !"
          }
        },
        "hi": {
