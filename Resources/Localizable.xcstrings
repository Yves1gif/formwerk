    "Draw and pick with Apple Pencil, or tap with your finger.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم وحدّد باستخدام Apple Pencil، أو اضغط بإصبعك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne und wähle mit dem Apple Pencil oder tippe mit dem Finger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja y selecciona con el Apple Pencil, o toca con el dedo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez et sélectionnez avec l’Apple Pencil, ou touchez avec le doigt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil से बनाएँ और चुनें, या उँगली से टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar dan pilih dengan Apple Pencil, atau ketuk dengan jari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna e seleziona con Apple Pencil, oppure tocca con il dito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencilで描画や選択ができます。指でタップすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil로 그리고 선택하거나 손가락으로 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken en kies met Apple Pencil, of tik met je vinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysuj i wybieraj za pomocą Apple Pencil albo stukaj palcem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe e selecione com o Apple Pencil, ou toque com o dedo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil ile çizin ve seçin ya da parmağınızla dokunun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Pencil 绘制和选取，或用手指轻点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple Pencil 繪製和選取，或用手指輕點。"
          }
        }
      }
    },
