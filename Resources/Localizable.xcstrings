    },
    "No bodies yet. Start with a sketch or a box.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أجسام بعد. ابدأ برسم أو بصندوق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Körper. Beginne mit einer Skizze oder einem Quader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay cuerpos. Empieza con un boceto o una caja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun corps pour l’instant. Commencez par une esquisse ou une boîte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई बॉडी नहीं है। स्केच या बॉक्स से शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada bodi. Mulai dengan sketsa atau kotak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun corpo. Inizia con uno schizzo o un parallelepipedo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボディはまだありません。スケッチまたはボックスから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 바디가 없습니다. 스케치나 상자로 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen lichamen. Begin met een schets of een balk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak brył. Zacznij od szkicu lub kostki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há corpos. Comece com um esboço ou uma caixa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz gövde yok. Bir eskiz ya da kutuyla başlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有实体。从草图或长方体开始吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無實體。從草圖或長方體開始吧。"
          }
        }
      }
    },
    "No earlier purchase was found for this Apple Account.": {
